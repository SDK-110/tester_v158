    <!-- Exclude files that use WinRT XAML (not available in WinForms) -->
    <!-- Note: debug_form files were not in original csproj but are referenced by other Multi_Form files -->
    <!-- Exclude winio (uses native WinIO driver, may not be needed) -->
    <Compile Remove="winio\Gpio.cs" />
    <Compile Remove="winio\OpenLibSys.cs" />
    <Compile Remove="winio\Utils.cs" />
    <!-- Exclude old Properties files not in original csproj -->
    <Compile Remove="Properties\viewloader.cs" />
    <Compile Remove="Properties\viewloader_setting.cs" />
    <!-- Exclude other files not in original csproj -->
    <Compile Remove="useful\access.cs" />
  </ItemGroup>

