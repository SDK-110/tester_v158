<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>testapp</RootNamespace>
    <AssemblyName>testapp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>bitbug_favicon (1).ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>testapp.Program</StartupObject>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS0162;CS8601;CS8602;CS8603;CS8625;CA1416;CA1418;CS8981;CS0169;NU1701;SYSLIB0014</NoWarn>
    <!-- MSB3277: 遗留 DLL 引用导致的程序集版本冲突（AForge/Metro/EPPlus 等），转为消息不再告警 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- MSB3825: 保留 resx 中 imageList 的 BinaryFormatter 使用，关闭该提示 -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PackageIcon>Bff10.png</PackageIcon>
    <PackageIconUrl />
  </PropertyGroup>

  <!-- Exclude old/duplicate directories from compilation -->
  <ItemGroup>
    <Compile Remove="lib\**" />
