  <!--
    FTD2XX_NET.dll 是 Festool 包以 contentFile 形式拷到输出目录的，不是编译引用，
    Costura 不会自动嵌入。按 Costura 的资源命名手动嵌入，运行时由其 AssemblyResolve 加载。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\packages\Festool.Sdk.PhysicalLayer.Rs232.2.0.1\contentFiles\Ftdi\FTD2XX_NET.dll">
      <LogicalName>costura.ftd2xx_net.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Festool 包的 targets 在 Build 之后还会把 FTD2XX_NET.dll/.XML 再拷一次。
    该 DLL 已手动嵌入 testapp.dll，这里在它复制前从 Files 列表移除，避免回写到输出目录。
  -->
  <Target Name="SkipFtd2xxContentCopy" BeforeTargets="CopyFiles">
    <ItemGroup>
      <Files Remove="@(Files)"
             Condition="'%(Filename)%(Extension)' == 'FTD2XX_NET.dll' Or '%(Filename)%(Extension)' == 'FTD2XX_NET.XML'" />
    </ItemGroup>
  </Target>

  <!--
    Costura.Fody 已把托管的引用 DLL 全部嵌入 testapp.dll，但 MSBuild 仍会把它们拷到输出目录。
    这里在编译后删除这些冗余 DLL（Costura 运行时从内嵌资源加载），只保留主程序集。
    若以后新增无法嵌入的原生 DLL，把它加入下面的 Exclude。
  -->
  <Target Name="RemoveCosturaEmbeddedDlls" AfterTargets="Build">
    <ItemGroup>
      <CosturaEmbeddedDll Include="$(OutDir)*.dll" Exclude="$(OutDir)testapp.dll" />
      <ReferenceDocXml Include="$(OutDir)FTD2XX_NET.XML" />
    </ItemGroup>
    <Delete Files="@(CosturaEmbeddedDll);@(ReferenceDocXml)" />
    <!-- 清理旧版多 RID 构建遗留的目录（原生依赖已嵌入 testapp.dll） -->
    <RemoveDir Directories="$(OutDir)runtimes;$(OutDir)win-x86" />
  </Target>

